<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="automation_tasker_title">Tasker / 外部自动化触发</string>
    <string name="automation_tasker_desc">允许其他应用发送广播触发一次文本补全；不会授予工具权限，但可能消耗模型额度。</string>
    <string name="automation_master_title">允许屏幕自动化</string>
    <string name="automation_master_desc">总开关。关闭后所有读屏/点击/输入/多步任务工具都会立刻拒绝执行，直到重新打开。</string>
    <string name="automation_master_off_banner">当前已停用：所有读屏、点击、输入与多步任务工具都会拒绝执行，直到你重新打开上面的开关。</string>
    <string name="automation_a11y_off_banner">无障碍服务当前未连接（可能被系统回收）。读屏与点击此刻都会失败。</string>
    <string name="automation_a11y_off_action">去开启无障碍</string>
    <string name="automation_autonomous_title">按时段自主使用无障碍</string>
    <string name="automation_autonomous_desc">先由你在对话里明确交代任务，再在指定时段内按白名单执行。仅对读屏、点击、滑动生效；输入、发送、发布、付款和删除动作仍逐次审批。</string>
    <string name="automation_autonomous_enabled">启用自主无障碍</string>
    <string name="automation_autonomous_enabled_desc">只在允许时段、目标应用、动作和每日次数全部匹配时自动执行。</string>
    <string name="automation_autonomous_window">允许时段</string>
    <string name="automation_autonomous_start">开始时间</string>
    <string name="automation_autonomous_end">结束时间</string>
    <string name="automation_autonomous_packages">应用包名白名单</string>
    <string name="automation_autonomous_packages_desc">每行一个包名。默认只含小红书：com.xingin.xhs</string>
    <string name="automation_autonomous_actions">允许动作</string>
    <string name="automation_autonomous_read">读屏</string>
    <string name="automation_autonomous_click">点击</string>
    <string name="automation_autonomous_scroll">滑动</string>
    <string name="automation_autonomous_input">输入</string>
    <string name="automation_autonomous_daily_limit">每日最多执行</string>
    <string name="automation_autonomous_daily_limit_desc">只在工具成功执行后计数；达到上限立即撤销当前任务授权。</string>
    <string name="automation_autonomous_task">对话任务授权</string>
    <string name="automation_autonomous_task_desc">不会把“上午两点到五点”的时段设置当成授权。请先在对话里明确写出目标包名和操作任务，然后在这里确认；授权只对最近一条用户消息和当前对话有效。</string>
    <string name="automation_autonomous_confirm_task">确认当前任务授权</string>
    <string name="automation_autonomous_confirm_required">请先在当前对话里明确说出任务和包名</string>
    <string name="automation_autonomous_saved">自主无障碍设置已保存</string>
    <string name="automation_autonomous_task_confirmed">已授权当前对话中的这次任务</string>
    <string name="automation_autonomous_task_cleared">已撤销自主无障碍任务授权</string>
    <string name="automation_autonomous_task_missing_session">请先打开一个对话再确认任务</string>
    <string name="automation_autonomous_task_text">当前任务：%1$s</string>
    <string name="automation_autonomous_active_until">授权状态：有效，需在时段内且前台应用匹配</string>
    <string name="automation_autonomous_no_grant">授权状态：未授权</string>
    <string name="automation_autonomous_save">保存设置</string>
</resources>
