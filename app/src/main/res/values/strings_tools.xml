    <!-- 标题与说明 -->
    <string name="tools_screen_title">AI 工具</string>
    <string name="tools_intro_what">工具是 AI 可调用的能力,如读取通知、计算、执行代码等</string>
    <string name="tools_intro_manage">在助手详情页 → 扩展 → 工具,可为每个助手单独启用/禁用工具。高风险工具(如代码执行)调用前会要求用户确认。</string>
