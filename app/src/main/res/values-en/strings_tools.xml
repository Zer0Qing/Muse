    <!-- Built-in plugins -->
    <string name="tools_plugins_section">Built-in plugins</string>
    <string name="tools_plugins_desc">Plugins are coarser-grained capability sets that declare required permissions and activation timing. Below is the list of app-preset built-in plugins, for understanding the boundary of AI capabilities.</string>

