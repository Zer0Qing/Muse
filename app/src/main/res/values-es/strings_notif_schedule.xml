    <string name="notif_listener_screen_title">Escucha de notificaciones</string>
    <string name="notif_bridge_title">Acceso al puente de mensajes</string>
    <string name="notif_bridge_desc">Al activarlo para una fuente, su texto de notificación puede entrar al contexto del chat (solo local; las demás siguen ocultas)</string>
    <string name="notif_listener_open_settings_failed">No se puede abrir la configuración del sistema</string>
    <string name="notif_listener_auth_settings">Conceder acceso</string>
    <string name="notif_listener_cleared_toast">Registros de notificación borrados</string>
    <string name="notif_listener_clear_records">Borrar registros</string>
    <string name="notif_listener_feature_title">Descripción de la función</string>
    <string name="notif_listener_feature_desc">Una vez autorizado, Muse puede detectar las notificaciones de otras apps como fuentes de eventos para que la IA las consulte en el chat. Por ejemplo, puedes preguntar: «¿Qué notificaciones de WeChat he recibido hoy?» «¿Hay algo importante en los mensajes no leídos?»</string>
    <string name="notif_listener_privacy_title">Límite de privacidad</string>
    <string name="notif_listener_privacy_desc">• El contenido de las notificaciones solo se almacena localmente (máximo 200 entradas; cuando se llena, se descartan las más antiguas)\n• La interfaz del sistema y las notificaciones propias de Muse se filtran y no se recopilan\n• No se sube ningún dato de notificaciones a ningún servidor\n• Puedes usar «Borrar registros» en esta página o revocar el acceso en los ajustes del sistema en cualquier momento</string>
    <string name="notif_listener_recent_header">Notificaciones recientes (%1$d/200)</string>
    <string name="notif_listener_empty_connected">Aún no hay registros de notificaciones\nLas nuevas notificaciones aparecerán aquí automáticamente una vez autorizadas</string>
    <string name="notif_listener_empty_disconnected">Aún no autorizado\nPrimero toca «Conceder acceso» arriba</string>
    <string name="notif_listener_authorized">Autorizado</string>
    <string name="notif_listener_unauthorized">No autorizado</string>
    <string name="notif_listener_recent_count_disconnected">Notificaciones recientes: %1$d · Primero concede acceso en los ajustes del sistema</string>
    <string name="notif_listener_refresh_cd">Actualizar estado</string>
    <string name="safe_mode_data_recovery">Guía de recuperación de datos</string>
    <string name="safe_mode_data_recovery_title">Guía de recuperación de datos</string>
    <string name="safe_mode_data_recovery_desc">Este fallo no afecta a tus datos locales; los chats y ajustes están intactos. Para restaurar desde una copia en la nube: tras reiniciar, ve a Ajustes → Copia de seguridad → Restaurar desde la nube.</string>
    <string name="safe_mode_data_recovery_ok">Entendido</string>
    <string name="safe_mode_continue_normal_desc">Conserva tus chats y ajustes e intenta abrir Muse de nuevo</string>
    <string name="safe_mode_disable_plugins">Desactivar todos los plugins y reiniciar</string>
    <string name="safe_mode_disable_plugins_desc">Los plugins son la causa más común de fallos. Al desactivarlos, la app arranca con normalidad; puedes restaurarlos cuando quieras desde la página de gestión de plugins.</string>
    <string name="plugin_kill_switch_title">Todos los plugins están desactivados</string>
    <string name="plugin_kill_switch_desc">Es el interruptor del modo seguro: herramientas, comandos, eventos, hooks y tareas no se ejecutan. Restaura para volver a activarlos.</string>
    <string name="plugin_kill_switch_restore">Restaurar plugins</string>
    <string name="plugin_kill_switch_disable">Desactivar todos los plugins</string>
