    <!-- v2.6.0: built-in prompt template bodies (previously hardcoded Chinese) -->
    <string name="prompt_template_content_write_email">Escribe un correo electrónico sobre el siguiente tema:\n\n{Tema}\n\nRequisitos: usa un tono formal y conciso; incluye un saludo, el cuerpo del mensaje y una despedida.</string>
    <string name="prompt_template_content_write_article">Escribe un artículo bien estructurado sobre el siguiente tema:\n\n{Tema}\n\nRequisitos: incluye una introducción, un desarrollo con 2 o 3 puntos clave y una conclusión; unas 800 palabras.</string>
    <string name="prompt_template_content_translate_zh_en">Traduce el siguiente texto chino a un inglés natural y fluido, conservando el significado y las expresiones propias de hablantes nativos:\n\n{Texto en chino}</string>
    <string name="prompt_template_content_translate_en_zh">Traduce el siguiente texto inglés a un chino natural y fluido, conservando el significado y usando expresiones idiomáticas:\n\n{Texto en inglés}</string>
    <string name="prompt_template_content_summarize">Resume el siguiente contenido en una lista de 3 a 5 puntos, con una oración por punto y conservando la información clave:\n\n{Contenido}</string>
    <string name="prompt_template_content_summarize_meeting">Convierte las siguientes notas en un acta estructurada que incluya el tema de la reunión, los puntos principales del debate, las decisiones y las tareas de seguimiento con sus responsables:\n\n{Notas de la reunión}</string>
    <string name="prompt_template_content_code_review">Revisa el siguiente código y sugiere mejoras en cuatro aspectos: legibilidad, rendimiento, seguridad y casos límite:\n\n```\n{Código}\n```</string>
    <string name="prompt_template_content_code_explain">Explica el siguiente código línea por línea, indicando qué hace y cómo funciona en un lenguaje sencillo:\n\n```\n{Código}\n```</string>
    <string name="prompt_template_content_code_refactor">Refactoriza el siguiente código para mejorar su legibilidad y facilitar su mantenimiento, y explica el motivo de cada cambio:\n\n```\n{Código}\n```</string>
    <string name="prompt_template_content_learn_concept">Explica el siguiente concepto en un lenguaje sencillo, con una definición, sus puntos clave y un ejemplo de la vida cotidiana:\n\n{Concepto}</string>
    <string name="prompt_template_content_learn_quiz">Crea 5 preguntas de opción múltiple sobre el siguiente tema, con respuestas y explicaciones, ordenadas de menor a mayor dificultad:\n\n{Tema}</string>
    <string name="prompt_template_content_creative_story">Escribe un relato de unas 500 palabras a partir de la siguiente premisa, centrándote en la ambientación y los giros de la trama:\n\n{Premisa}</string>
    <string name="prompt_template_content_creative_brainstorm">Propón 10 enfoques creativos para el siguiente problema, con una oración por enfoque:\n\n{Problema}</string>

