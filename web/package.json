{
  "name": "@muse/web-workspace",
  "private": true,
  "version": "0.1.0",
  "description": "Muse Web/PWA SaaS workspace",
  "packageManager": "npm@11.16.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:client": "npm --workspace @muse/client run dev",
    "dev:api": "npm --workspace @muse/api run dev",
    "dev:admin": "npm --workspace @muse/admin run dev",
    "dev:worker": "npm --workspace @muse/worker run dev",
    "build": "npm run typecheck && npm run build:client && npm run build:api && npm run build:admin && npm run build:worker",
    "build:client": "npm --workspace @muse/client run build",
    "build:api": "npm --workspace @muse/api run build",
    "build:admin": "npm --workspace @muse/admin run build",
    "build:worker": "npm --workspace @muse/worker run build",
    "typecheck": "npm run typecheck:contracts && npm run build:contracts && npm run typecheck:core && npm run build:core && npm run typecheck:provider && npm run build:provider && npm run typecheck:jobs && npm run build:jobs && npm run typecheck:storage && npm run build:storage && npm run typecheck:database && npm run build:database && npm run typecheck:memory && npm run build:memory && npm run typecheck:tools && npm run build:tools && npm run typecheck:rag && npm run build:rag && npm run typecheck:files && npm run build:files && npm run typecheck:mcp && npm run build:mcp && npm run typecheck:agents && npm run build:agents && npm run typecheck:client && npm run typecheck:admin && npm run typecheck:api && npm run typecheck:worker",
    "typecheck:contracts": "npm --workspace @muse/contracts run typecheck",
    "build:contracts": "npm --workspace @muse/contracts run build",
    "typecheck:core": "npm --workspace @muse/core run typecheck",
    "build:core": "npm --workspace @muse/core run build",
    "build:provider": "npm --workspace @muse/provider run build",
    "build:database": "npm --workspace @muse/database run build",
    "build:memory": "npm --workspace @muse/memory run build",
    "build:tools": "npm --workspace @muse/tools run build",
    "build:rag": "npm --workspace @muse/rag run build",
    "build:files": "npm --workspace @muse/files run build",
    "build:mcp": "npm --workspace @muse/mcp run build",
    "build:agents": "npm --workspace @muse/agents run build",
    "build:jobs": "npm --workspace @muse/jobs run build",
    "build:storage": "npm --workspace @muse/storage run build",
    "typecheck:storage": "npm --workspace @muse/storage run typecheck",
    "typecheck:tools": "npm --workspace @muse/tools run typecheck",
    "typecheck:rag": "npm --workspace @muse/rag run typecheck",
    "typecheck:files": "npm --workspace @muse/files run typecheck",
    "typecheck:mcp": "npm --workspace @muse/mcp run typecheck",
    "typecheck:agents": "npm --workspace @muse/agents run typecheck",
    "typecheck:jobs": "npm --workspace @muse/jobs run typecheck",
    "typecheck:memory": "npm --workspace @muse/memory run typecheck",
    "typecheck:database": "npm --workspace @muse/database run typecheck",
    "typecheck:provider": "npm --workspace @muse/provider run typecheck",
    "typecheck:client": "npm --workspace @muse/client run lint",
    "typecheck:admin": "npm --workspace @muse/admin run lint",
    "typecheck:api": "npm --workspace @muse/api run typecheck",
    "typecheck:worker": "npm --workspace @muse/worker run typecheck",
    "test": "npm run test:contracts && npm run test:core && npm run test:provider && npm run test:jobs && npm run test:storage && npm run test:database && npm run test:memory && npm run test:tools && npm run test:rag && npm run test:files && npm run test:mcp && npm run test:agents && npm run test:api",
    "test:provider": "npm --workspace @muse/provider run test",
    "test:database": "npm --workspace @muse/database run test",
    "test:memory": "npm --workspace @muse/memory run test",
    "test:tools": "npm --workspace @muse/tools run test",
    "test:rag": "npm --workspace @muse/rag run test",
    "test:files": "npm --workspace @muse/files run test",
    "test:mcp": "npm --workspace @muse/mcp run test",
    "test:agents": "npm --workspace @muse/agents run test",
    "test:jobs": "npm --workspace @muse/jobs run test",
    "test:storage": "npm --workspace @muse/storage run test",
    "test:api": "npm --workspace @muse/api run test",
    "test:contracts": "npm --workspace @muse/contracts run test",
    "test:core": "npm --workspace @muse/core run test",
    "lint": "npm run lint:client && npm run lint:api && npm run lint:admin",
    "lint:client": "npm --workspace @muse/client run lint",
    "lint:api": "npm --workspace @muse/api run lint",
    "lint:admin": "npm --workspace @muse/admin run lint",
    "db:migrate": "npm --workspace @muse/api run db:migrate",
    "check:security": "npm run check:contracts && npm run check:core && npm run check:provider && npm run check:memory && npm run check:tools && npm run check:rag && npm run check:files && npm run check:mcp && npm run check:agents && npm run check:jobs && npm run check:storage && npm run check:api",
    "check:contracts": "npm --workspace @muse/contracts run check:security",
    "check:core": "npm --workspace @muse/core run check:security",
    "check:api": "npm --workspace @muse/api run check:security",
    "check:provider": "npm --workspace @muse/provider run check:security",
    "check:memory": "npm --workspace @muse/memory run check:security",
    "check:tools": "npm --workspace @muse/tools run check:security",
    "check:rag": "npm --workspace @muse/rag run check:security",
    "check:files": "npm --workspace @muse/files run check:security",
    "check:mcp": "npm --workspace @muse/mcp run check:security",
    "check:agents": "npm --workspace @muse/agents run check:security",
    "check:jobs": "npm --workspace @muse/jobs run check:security",
    "check:storage": "npm --workspace @muse/storage run check:security"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3"
  },
  "optionalDependencies": {
    "@esbuild/linux-x64": "0.25.12",
    "@esbuild/linux-arm64": "0.25.12",
    "@esbuild/win32-x64": "0.25.12",
    "@rollup/rollup-linux-x64-musl": "4.63.1",
    "@rollup/rollup-linux-x64-gnu": "4.63.1",
    "@rollup/rollup-win32-x64-msvc": "4.63.1"
  }
}
