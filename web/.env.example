NODE_ENV=development
PORT=8080
WEB_ORIGIN=http://localhost:5173
DATABASE_URL=postgres://muse:muse_dev_only@localhost:5432/muse
REDIS_URL=redis://localhost:6379
# S3-compatible storage; placeholder credentials keep the explicit local fallback.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=muse
S3_ACCESS_KEY=muse
S3_SECRET_KEY=replace-me
S3_FORCE_PATH_STYLE=true
SESSION_SECRET=replace-with-a-long-random-secret
SECRETS_MASTER_KEY=replace-with-at-least-32-random-bytes
VAPID_PUBLIC_KEY=replace-me
VAPID_PRIVATE_KEY=replace-me
# Vite exposes only the public key to the browser.
VITE_VAPID_PUBLIC_KEY=replace-me
ALIPAY_GATEWAY=mock
