FROM node:22-alpine AS build
WORKDIR /workspace
COPY . .
ARG VITE_API_BASE=http://localhost:8080
ARG VITE_VAPID_PUBLIC_KEY=
ENV VITE_API_BASE=$VITE_API_BASE
ENV VITE_VAPID_PUBLIC_KEY=$VITE_VAPID_PUBLIC_KEY
RUN npm ci --ignore-scripts --no-audit --no-fund
RUN npm run build:contracts && npm run build:core && npm run build:provider && npm --workspace @muse/client run build
FROM nginx:1.27-alpine
COPY --from=build /workspace/apps/client/dist /usr/share/nginx/html
COPY infra/nginx/client.conf /etc/nginx/conf.d/default.conf
