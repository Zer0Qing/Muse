FROM node:22-alpine AS build
WORKDIR /workspace
COPY . .
RUN npm ci --ignore-scripts --no-audit --no-fund
RUN npm run build:contracts && npm run build:core && npm run build:jobs && npm run build:memory && npm run build:rag && npm run build:files && npm run build:database && npm --workspace @muse/worker run build
FROM node:22-alpine
WORKDIR /app
COPY --from=build /workspace/node_modules ./node_modules
COPY --from=build /workspace/apps/worker/dist ./apps/worker/dist
COPY --from=build /workspace/apps/worker/package.json ./apps/worker/package.json
COPY --from=build /workspace/packages ./packages
CMD ["node", "apps/worker/dist/worker.js"]
