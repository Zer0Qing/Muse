# Git ignore for Muse project submodule
.gradle/
.idea/
.kotlin/
build/
build_alt/
*.iml
*.ipr
*.iws
local.properties
keystore.properties
*.keystore
*.jks
*.env
*.log
.DS_Store
Thumbs.db

# 项目文档：源码仓库只保留插件作者需要的那一份，其余归入外层工作区
/docs/*
!/docs/plugin/
!/docs/plugin/**

# 内部审查工作区：不随源码发布（含历史事故记录与凭据线索）
/.audit/

# 贡献与计划文档：SECURITY.md 属于希望公开的安全政策，必须入库
CONTRIBUTING.md
!/CONTRIBUTING.md
Muse_Product_Enhancement_Plan.md
_skill_existing.txt
report_*.txt

# 临时文件
compile_log2.txt
__pycache__/
*.pyc
tmp_head.kt
tmp_*.kt
build_log*.txt
build-log*.txt
build_output*.txt
build-*.txt
.tmp/

# 测试数据库产物
*.db
*.db-wal
*.db-shm

# 软著申请材料
软件著作权申请材料/

# 发布 APK 不入库(仅挂 GitHub Release 附件)
releases/**/*.apk

# F-05: 发布 manifest 为构建产物(每次构建生成,不入库)
release/

# README 预览产物(gen_preview.py 随时重新生成,不入库)
docs/assets/readme/preview.html
docs/assets/readme/preview-*.png

# CMake 构建产物(终端二期原生构建)
.cxx/
**/.cxx/

# P0 内置运行时产物(由 tools/runtime-pack 脚本生成；分发走独立资产渠道,不入库)
app/src/main/jniLibs/
app/src/main/assets/muse-runtime-assets.zip
# v2.7 内置 Python 运行时产物(由 tools/python-pack 脚本生成；同上不入库)
app/src/main/assets/muse-python-assets.zip
# ktlint 工具在工作目录生成的临时基线（真实基线在 <module>/ktlint-baseline.xml）
app/config/
